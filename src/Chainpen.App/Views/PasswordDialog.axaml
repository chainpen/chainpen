<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Chainpen.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Chainpen.App.Controls"
             x:Class="Chainpen.App.Views.PasswordDialog"
             Width="480">
    <!-- D12: asking instead of failing. The password is never kept. -->
    <Border Classes="dialog">
        <StackPanel Spacing="0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <c:StrokeIcon Data="{StaticResource IconLock}" Size="24" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" />
                <TextBlock x:Name="Heading" Classes="heading-dialog" MaxWidth="390" />
            </StackPanel>
            <TextBlock Classes="muted" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="{x:Static l:Strings.Password_WhoeverMadeTheFileSetThe}" />
            <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" Text="{x:Static l:Strings.Password_Password}" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="Password" PasswordChar="•" MinHeight="44" FontSize="15" LetterSpacing="2"
                         AutomationProperties.Name="{x:Static l:Strings.Password_Password}" KeyDown="OnKeyDown" />
                <Button x:Name="ShowButton" Grid.Column="1" Classes="link" Margin="8,0,0,0" Click="OnToggleShow"
                        AutomationProperties.Name="{x:Static l:Strings.Password_ShowPassword}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:StrokeIcon x:Name="ShowIcon" Data="{StaticResource IconEye}" />
                        <TextBlock x:Name="ShowText" FontWeight="SemiBold" Text="{x:Static l:Strings.Password_Show}" />
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel x:Name="Error" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" IsVisible="False"
                        AutomationProperties.LiveSetting="Assertive">
                <c:StrokeIcon Data="{StaticResource IconWarningCircle}" Size="16" Foreground="{DynamicResource Danger}" />
                <TextBlock FontSize="13" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                           Text="{x:Static l:Strings.Password_ThatPasswordDidntOpenTheFile}" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="{x:Static l:Strings.Password_ChainpenDoesntKeepThePasswordCopies}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,22,0,0">
                <Button Content="{x:Static l:Strings.Common_Cancel}" Click="OnCancel" />
                <Button Classes="primary" Content="{x:Static l:Strings.Common_Open}" Click="OnOpen" />
            </StackPanel>
        </StackPanel>
    </Border>
    <UserControl.Styles>
        <Style Selector="TextBox.error, TextBox.error:focus, TextBox.error:pointerover">
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBox.error /template/ Border#PART_BorderElement, TextBox.error:focus /template/ Border#PART_BorderElement, TextBox.error:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
        </Style>
    </UserControl.Styles>
</UserControl>
