<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chainpen.App.App"
             Name="Chainpen"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Chainpen.App/Styles/Tokens.axaml" />
                <ResourceInclude Source="avares://Chainpen.App/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="InterFont">fonts:Inter#Inter</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <!--
            Fluent's own controls (check boxes, focused text boxes) are drawn in its accent, which otherwise follows the
            system's, usually blue. The light theme uses Accent; the dark one uses Primary, as #7443c9 is only 2.6:1
            on the dark surface and check boxes are filled with it.
        -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#7443c9" />
                <ColorPaletteResources x:Key="Dark" Accent="#8b5ecd" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Chainpen.App/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
