<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AvaloniaVersion>12.1.6</AvaloniaVersion>
    <PdfiumVersion>160.0.8165</PdfiumVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- PDF -->
    <!-- Per-OS packages; the bblanchon.PDFium meta-package also pulls iOS/Android, which don't restore on net11.0. -->
    <PackageVersion Include="bblanchon.PDFium.Win32" Version="$(PdfiumVersion)" />
    <PackageVersion Include="bblanchon.PDFium.macOS" Version="$(PdfiumVersion)" />
    <PackageVersion Include="bblanchon.PDFium.Linux" Version="$(PdfiumVersion)" />
    <!-- Same version Avalonia 12 ships; its native library also exports hb-subset (font subsetting for the PDFium writer). -->
    <PackageVersion Include="HarfBuzzSharp" Version="8.3.1.3" />
    <!-- Same version Avalonia 12.1.6 ships; decodes photos and scans for image-to-page conversion. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <!-- HarfBuzzSharp itself only brings the Windows and macOS natives. -->
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
