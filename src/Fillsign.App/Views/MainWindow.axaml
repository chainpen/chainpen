<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fillsign.App.ViewModels"
        x:Class="Fillsign.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://Fillsign.App/Assets/Icon/fillsign-256.png"
        Width="1280" Height="860" MinWidth="1024" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">
    <Panel>
        <DockPanel>
            <!-- Windows and Linux show the menus here; on macOS they're in the system menu bar (FS-700). -->
            <NativeMenuBar DockPanel.Dock="Top" />
            <ContentControl x:Name="Host" />
        </DockPanel>

        <!-- First-run tips (E1): shown once, not modal. -->
        <Border x:Name="FirstRunTips" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="300,150,0,0"
                Width="380" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                CornerRadius="12" Padding="20,18" BoxShadow="{StaticResource ShadowPopover}">
            <StackPanel Spacing="12">
                <TextBlock Classes="heading-section" Text="Fill in this form in four steps" />
                <ItemsControl x:Name="FirstRunSteps">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" MinHeight="36" Content="Got it" Click="OnDismissTips" />
                    <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="You can find this again in the Help menu." />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Modal dialogs over a dimmed window. -->
        <Border x:Name="DialogLayer" IsVisible="False" Background="{DynamicResource Overlay}">
            <ContentControl x:Name="DialogHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0" />
        </Border>
    </Panel>
</Window>
