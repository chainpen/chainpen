<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Fillsign.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Fillsign.App.Controls"
             xmlns:vm="using:Fillsign.App.ViewModels"
             x:Class="Fillsign.App.Views.SignatureDialog"
             x:DataType="vm:SignatureDialogViewModel">
    <!-- D1–D3, D10, D11: choose a saved signature or make one, then Place. -->
    <Border Classes="dialog">
        <Panel>
            <!-- ===== The form ===== -->
            <!-- FS-709: on a short window the middle scrolls; the title and buttons stay put (S5). -->
            <!-- Children in reading order, so Tab follows the screen: title, then the choices, then the buttons. -->
            <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsForm}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="icon" BorderThickness="0" Background="Transparent" VerticalAlignment="Top"
                            Command="{Binding CancelCommand}" AutomationProperties.Name="{x:Static l:Strings.Common_Close}">
                        <c:StrokeIcon Data="{StaticResource IconCross}" Foreground="{DynamicResource TextMuted}" />
                    </Button>
                    <TextBlock Classes="heading-dialog" FontSize="20" VerticalAlignment="Center" Text="{Binding Title}" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="-4,0">
                    <StackPanel Margin="4,4">
                        <TextBlock Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding FirstTimeHint}"
                                   IsVisible="{Binding !HasSaved}" />

                        <!-- The dialog makes the one kind it was opened for: Sign, or Sign ▾ → Initials (UX review 7). -->

                        <!-- Saved ones, most recently used first and preselected, then New (FR-4.6). -->
                        <StackPanel IsVisible="{Binding HasSaved}">
                            <TextBlock x:Name="ChooseHeading" Margin="0,18,0,8" FontWeight="SemiBold" Text="{Binding ChooseHeading}" />
                            <ListBox x:Name="OptionList" Classes="options" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                     AutomationProperties.LabeledBy="{Binding #ChooseHeading}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ItemSpacing="10" LineSpacing="10" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SignatureOptionViewModel">
                                        <Panel AutomationProperties.Name="{Binding AccessibleName}">
                                            <Image Source="{Binding Thumbnail}" MaxWidth="140" MaxHeight="48" Stretch="Uniform"
                                                   IsVisible="{Binding !IsNew}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding IsNew}">
                                                <c:StrokeIcon Data="{StaticResource IconPlus}" Foreground="{DynamicResource Accent}" />
                                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Text="{Binding NewLabel}" />
                                            </StackPanel>
                                        </Panel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Classes="muted" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding SavedHint}"
                                       IsVisible="{Binding IsSavedSelected}" />
                        </StackPanel>

                        <!-- The chosen saved signature, as it will look. -->
                        <Border IsVisible="{Binding IsSavedSelected}" Margin="0,16,0,0" Padding="20" CornerRadius="{StaticResource RadiusLarge}"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource Page}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Image Source="{Binding SelectedSaved.Thumbnail, FallbackValue={x:Null}}" MaxWidth="260" MaxHeight="72" Stretch="Uniform"
                                       AutomationProperties.Name="{Binding SelectedSaved.AccessibleName, FallbackValue=''}" />
                                <TextBlock Classes="caption" Foreground="#4a505a" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           Text="{Binding PlaceLabel, StringFormat={x:Static l:Strings.Signature_AfterYouChoose}}" />
                            </StackPanel>
                        </Border>

                        <!-- ===== Making a new one ===== -->
                        <StackPanel IsVisible="{Binding IsCreating}">
                            <Border Margin="0,16,0,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtle}">
                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <RadioButton Classes="tab" GroupName="method" Content="{x:Static l:Strings.Common_Draw}" IsChecked="{Binding IsDrawTab}" />
                                    <RadioButton Classes="tab" GroupName="method" Content="{x:Static l:Strings.Signature_Type}" IsChecked="{Binding IsTypeTab}" />
                                    <RadioButton Classes="tab" GroupName="method" Content="{x:Static l:Strings.Signature_PhotoOrScan}" IsChecked="{Binding IsPhotoTab}" />
                                </StackPanel>
                            </Border>

                            <!-- Type: the name first, then ink and style. -->
                            <StackPanel IsVisible="{Binding IsTypeTab}">
                                <TextBlock x:Name="TypeLabel" Margin="0,16,0,6" FontWeight="SemiBold" Text="{Binding TypeLabel}" />
                                <TextBox x:Name="TypedNameBox" Text="{Binding TypedName}" PlaceholderText="{Binding TypePlaceholder}" FontSize="15"
                                         MaxLength="60" AutomationProperties.LabeledBy="{Binding #TypeLabel}" KeyDown="OnTypedNameKeyDown" />
                            </StackPanel>

                            <Grid Margin="0,14,0,0" ColumnDefinitions="*,Auto" IsVisible="{Binding ShowsInk}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="InkLabel" Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{x:Static l:Strings.Signature_Ink}" />
                                    <RadioButton Classes="swatch" GroupName="ink" Background="{DynamicResource InkBlack}" IsChecked="{Binding IsBlackInk}"
                                                 AutomationProperties.Name="{x:Static l:Strings.Signature_BlackInk}" />
                                    <RadioButton Classes="swatch" GroupName="ink" Background="{DynamicResource InkBlue}" IsChecked="{Binding IsBlueInk}"
                                                 AutomationProperties.Name="{x:Static l:Strings.Signature_BlueInk}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="small" Content="{x:Static l:Strings.Signature_Clear}" Command="{Binding ClearPadCommand}"
                                        IsVisible="{Binding IsDrawTab}" IsEnabled="{Binding HasInk}" />
                            </Grid>

                            <!-- What's needed, shown after Place is pressed too early (FR-4.8). Clears once fixed. -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0" IsVisible="{Binding HasError}"
                                        AutomationProperties.LiveSetting="Assertive">
                                <c:StrokeIcon Data="{StaticResource IconWarningCircle}" Size="16" Foreground="{DynamicResource Danger}" VerticalAlignment="Top" />
                                <TextBlock x:Name="ErrorText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                                           MaxWidth="560" Text="{Binding Error}" />
                            </StackPanel>

                            <!-- Draw (D1). Initials get a smaller pad (D11). -->
                            <c:SignaturePad x:Name="Pad" Margin="0,8,0,0" IsVisible="{Binding IsDrawTab}" Classes.initials="{Binding IsInitials}"
                                            Strokes="{Binding Strokes}" Ink="{Binding Ink}" Hint="{Binding PadHint}" HasError="{Binding HasError}"
                                            AutomationProperties.Name="{x:Static l:Strings.Signature_SignaturePadSignWithYourMouse}" />

                            <!-- Type (D2): three handwriting styles. -->
                            <StackPanel IsVisible="{Binding IsTypeTab}">
                                <TextBlock x:Name="StyleLabel" Margin="0,14,0,8" FontWeight="SemiBold" Text="{x:Static l:Strings.Signature_Style}" />
                                <ListBox Classes="options styles" Margin="-5,0" ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding SelectedStyle}"
                                         AutomationProperties.LabeledBy="{Binding #StyleLabel}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StyleOptionViewModel">
                                            <TextBlock AutomationProperties.Name="{Binding AccessibleName}" FontFamily="{Binding FontFamily}"
                                                       FontWeight="{Binding FontWeight}" FontSize="{Binding PreviewSize}"
                                                       Foreground="{Binding $parent[UserControl].((vm:SignatureDialogViewModel)DataContext).InkBrush}"
                                                       Text="{Binding $parent[UserControl].((vm:SignatureDialogViewModel)DataContext).TypedPreview}"
                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Padding="12,4" ClipToBounds="False" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Photo or scan (D3). -->
                            <StackPanel IsVisible="{Binding IsPhotoTab}">
                                <Button Margin="0,14,0,0" HorizontalAlignment="Stretch" MinHeight="64" Command="{Binding ChoosePhotoCommand}"
                                        IsVisible="{Binding !HasPhoto}">
                                    <StackPanel Classes="content">
                                        <c:StrokeIcon Data="{StaticResource IconImage}" />
                                        <TextBlock Text="{x:Static l:Strings.Signature_ChooseAPhotoOrScan}" />
                                    </StackPanel>
                                </Button>
                                <Border IsVisible="{Binding HasPhoto}" Margin="0,14,0,0" Padding="12,8" CornerRadius="{StaticResource RadiusLarge}"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="small" Content="{x:Static l:Strings.Signature_ChooseAnother}" Command="{Binding ChoosePhotoCommand}" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <c:StrokeIcon Data="{StaticResource IconImage}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding PhotoName}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                            <TextBlock Classes="muted" Text="{Binding PhotoSize, StringFormat='· {0}'}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,14,0,0" IsVisible="{Binding HasPhoto}">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Static l:Strings.Signature_YourPhoto}" />
                                        <Border Height="150" CornerRadius="{StaticResource RadiusLarge}" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}"
                                                ClipToBounds="True" Padding="8">
                                            <Image Source="{Binding PhotoOriginal}" Stretch="Uniform" AutomationProperties.Name="{x:Static l:Strings.Signature_YourPhoto}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Static l:Strings.Signature_HowItWillLookOnThe}" />
                                        <Border Height="150" CornerRadius="{StaticResource RadiusLarge}" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}"
                                                ClipToBounds="True" Padding="8" Background="{StaticResource Checkerboard}">
                                            <Image Source="{Binding PhotoResult}" Stretch="Uniform" AutomationProperties.Name="{x:Static l:Strings.Signature_YourSignatureAsItWillLook}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Margin="0,14,0,0" IsChecked="{Binding RemoveBackground}" IsVisible="{Binding HasPhoto}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Static l:Strings.Signature_RemoveThePaperBackground}" />
                                        <TextBlock Classes="muted" FontSize="13" Text="{x:Static l:Strings.Signature_UntickIfPartsOfYourSignature}" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>

                            <!-- Keeping is opt-in and never preselected (FR-4.5). -->
                            <CheckBox Margin="0,14,0,0" IsChecked="{Binding KeepOnComputer}" IsEnabled="{Binding CanKeep}" Content="{Binding KeepLabel}" />
                            <TextBlock Classes="muted" FontSize="13" Margin="28,2,0,0" TextWrapping="Wrap" Text="{Binding KeepDetail}"
                                       IsVisible="{Binding KeepDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>

                        <!-- Problems with a saved one (for example it couldn't be removed). -->
                        <TextBlock Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                                   Text="{Binding SavedError}" IsVisible="{Binding SavedError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   AutomationProperties.LiveSetting="Assertive" />

                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Margin="0,18,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtle}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Panel VerticalAlignment="Center">
                            <Button Classes="link danger" HorizontalAlignment="Left" Content="{Binding RemoveLabel}"
                                    Command="{Binding AskToRemoveCommand}" IsVisible="{Binding IsSavedSelected}" />
                            <TextBlock Classes="muted" FontSize="13" Text="{x:Static l:Strings.Signature_ThePhotoStaysOnThisComputer}"
                                       IsVisible="{Binding IsPhotoTab}" />
                        </Panel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Button Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CancelCommand}" />
                            <Button x:Name="PlaceButton" Classes="primary" Content="{Binding PlaceLabel}" Command="{Binding PlaceCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== D10: removing a saved signature can't be undone, so ask. ===== -->
            <StackPanel IsVisible="{Binding IsConfirmingRemove}">
                <TextBlock Classes="heading-dialog" Text="{Binding RemoveTitle}" />
                <Border Margin="0,14,0,0" Padding="14" CornerRadius="{StaticResource RadiusLarge}" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource Page}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image Source="{Binding SelectedSaved.Thumbnail, FallbackValue={x:Null}}" MaxWidth="150" MaxHeight="42" Stretch="Uniform" />
                        <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{Binding SelectedSaved.Description, FallbackValue=''}" />
                    </StackPanel>
                </Border>
                <TextBlock Classes="muted" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="21"
                           Text="{x:Static l:Strings.Signature_ItWillBeRemovedFromThis}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
                    <!-- Focus starts on Cancel; Enter never triggers the red button. -->
                    <Button x:Name="KeepButton" Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CancelCommand}" />
                    <Button Classes="danger-fill" Content="{Binding RemoveButtonLabel}" Command="{Binding ConfirmRemoveCommand}" />
                </StackPanel>
            </StackPanel>
        </Panel>
    </Border>

    <UserControl.Resources>
        <!-- Shows transparency in the photo preview (D3). -->
        <VisualBrush x:Key="Checkerboard" TileMode="Tile" DestinationRect="0,0,16,16" SourceRect="0,0,16,16" Stretch="None">
            <VisualBrush.Visual>
                <Canvas Width="16" Height="16" Background="#ffffff">
                    <Rectangle Width="8" Height="8" Fill="#eef0f3" />
                    <Rectangle Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Fill="#eef0f3" />
                </Canvas>
            </VisualBrush.Visual>
        </VisualBrush>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Draw / Type / Photo tabs. -->
        <Style Selector="RadioButton.tab">
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Underline" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="4,0">
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextMuted}" FontWeight="Medium" FontSize="14" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tab:checked /template/ Border#Underline">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="RadioButton.tab:checked /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="RadioButton.tab:focus-visible /template/ Border#Underline">
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
        </Style>

        <!-- Option cards: saved signatures and handwriting styles. -->
        <Style Selector="ListBox.options">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox.options ListBoxItem">
            <Setter Property="Width" Value="170" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
            <!-- Signatures are ink on paper: the cards stay paper-coloured in the dark appearance too. -->
            <Setter Property="Background" Value="{DynamicResource Page}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.styles ListBoxItem">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Margin" Value="5,0" />
        </Style>
        <Style Selector="ListBox.options ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Page}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="ListBox.options ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.options ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Page}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ListBox.options ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="c|SignaturePad">
            <Setter Property="Height" Value="190" />
        </Style>
        <Style Selector="c|SignaturePad.initials">
            <Setter Property="Width" Value="360" />
            <Setter Property="Height" Value="150" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="Background" Value="{DynamicResource DangerTint}" />
        </Style>
    </UserControl.Styles>
</UserControl>
