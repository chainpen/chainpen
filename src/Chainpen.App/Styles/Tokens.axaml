<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Colour tokens copied from the Chainpen design system (tokens.json): one Color and one brush per token, named
        in PascalCase (surface-subtle → SurfaceSubtle). Keep in step with the design system. The page and the
        document inks are the same in both themes, because the document is never themed.

        Text colours meet WCAG 2.2 AAA (1.4.6): 7:1 on every surface they sit on, and outlines and button edges 3:1.
        The dark theme's filled buttons are a light fill with a dark label, since no violet or red keeps a white
        label at 7:1 and its edge at 3:1 on the dark surfaces.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SurfaceAppColor">#f4f5f7</Color>
            <SolidColorBrush x:Key="SurfaceApp" Color="#f4f5f7" />
            <Color x:Key="SurfaceColor">#ffffff</Color>
            <SolidColorBrush x:Key="Surface" Color="#ffffff" />
            <Color x:Key="SurfaceSubtleColor">#fbfbfc</Color>
            <SolidColorBrush x:Key="SurfaceSubtle" Color="#fbfbfc" />
            <Color x:Key="SurfaceSunkenColor">#eef0f3</Color>
            <SolidColorBrush x:Key="SurfaceSunken" Color="#eef0f3" />
            <Color x:Key="CanvasColor">#e9ebef</Color>
            <SolidColorBrush x:Key="Canvas" Color="#e9ebef" />
            <Color x:Key="PageColor">#fdfcf8</Color>
            <SolidColorBrush x:Key="Page" Color="#fdfcf8" />
            <Color x:Key="BorderSubtleColor">#e3e5e9</Color>
            <SolidColorBrush x:Key="BorderSubtle" Color="#e3e5e9" />
            <Color x:Key="BorderControlColor">#868c96</Color>
            <SolidColorBrush x:Key="BorderControl" Color="#868c96" />
            <Color x:Key="BorderControlOnSunkenColor">#7d838d</Color>
            <SolidColorBrush x:Key="BorderControlOnSunken" Color="#7d838d" />
            <Color x:Key="TextColor">#1b1e23</Color>
            <SolidColorBrush x:Key="Text" Color="#1b1e23" />
            <Color x:Key="TextMutedColor">#474d57</Color>
            <SolidColorBrush x:Key="TextMuted" Color="#474d57" />
            <Color x:Key="TextDisabledColor">#5c626c</Color>
            <SolidColorBrush x:Key="TextDisabled" Color="#5c626c" />
            <Color x:Key="AccentColor">#5d31aa</Color>
            <SolidColorBrush x:Key="Accent" Color="#5d31aa" />
            <Color x:Key="AccentStrongColor">#4a2a7a</Color>
            <SolidColorBrush x:Key="AccentStrong" Color="#4a2a7a" />
            <Color x:Key="AccentTintColor">#efe7fb</Color>
            <SolidColorBrush x:Key="AccentTint" Color="#efe7fb" />
            <Color x:Key="PrimaryColor">#4a2a7a</Color>
            <SolidColorBrush x:Key="Primary" Color="#4a2a7a" />
            <Color x:Key="OnPrimaryColor">#ffffff</Color>
            <SolidColorBrush x:Key="OnPrimary" Color="#ffffff" />
            <!-- A primary button under the pointer or pressed: darker, with white still on it. -->
            <SolidColorBrush x:Key="PrimaryHover" Color="#3a2161" />
            <SolidColorBrush x:Key="PrimaryHoverBorder" Color="#3a2161" />
            <Color x:Key="FocusRingColor">#4a2a7a</Color>
            <SolidColorBrush x:Key="FocusRing" Color="#4a2a7a" />
            <!-- The ring round a form field on the page, which is light in both themes. -->
            <SolidColorBrush x:Key="FocusRingOnPage" Color="#4a2a7a" />
            <!-- Selected text in boxes: a pale accent, so the text on it keeps its own colour and full contrast (WCAG 1.4.3). -->
            <SolidColorBrush x:Key="TextSelection" Color="#d9c8f5" />
            <Color x:Key="SelectionOnPageColor">#6334b4</Color>
            <SolidColorBrush x:Key="SelectionOnPage" Color="#6334b4" />
            <!-- The practice guide's "do this next": orange, so it never reads as a tool that's on or selected (violet). -->
            <SolidColorBrush x:Key="Guide" Color="#8a2e09" />
            <SolidColorBrush x:Key="GuideTint" Color="#ffedd5" />
            <SolidColorBrush x:Key="GuideStrong" Color="#8a2f10" />
            <Color x:Key="GuideOnPageColor">#9f350a</Color>
            <Color x:Key="WarningColor">#80380c</Color>
            <SolidColorBrush x:Key="Warning" Color="#80380c" />
            <Color x:Key="WarningTintColor">#fff7ed</Color>
            <SolidColorBrush x:Key="WarningTint" Color="#fff7ed" />
            <Color x:Key="WarningBorderColor">#f3d3b0</Color>
            <SolidColorBrush x:Key="WarningBorder" Color="#f3d3b0" />
            <Color x:Key="DangerColor">#961d14</Color>
            <SolidColorBrush x:Key="Danger" Color="#961d14" />
            <Color x:Key="DangerFillColor">#ac2117</Color>
            <SolidColorBrush x:Key="DangerFill" Color="#ac2117" />
            <SolidColorBrush x:Key="DangerFillHover" Color="#8f1c13" />
            <SolidColorBrush x:Key="DangerFillHoverBorder" Color="#8f1c13" />
            <Color x:Key="DangerTintColor">#fdecea</Color>
            <SolidColorBrush x:Key="DangerTint" Color="#fdecea" />
            <Color x:Key="SuccessColor">#185830</Color>
            <SolidColorBrush x:Key="Success" Color="#185830" />
            <Color x:Key="SuccessTintColor">#ecf7ef</Color>
            <SolidColorBrush x:Key="SuccessTint" Color="#ecf7ef" />
            <Color x:Key="UnsavedColor">#c2410c</Color>
            <SolidColorBrush x:Key="Unsaved" Color="#c2410c" />
            <Color x:Key="InfoTintColor">#f3eefc</Color>
            <SolidColorBrush x:Key="InfoTint" Color="#f3eefc" />
            <Color x:Key="InkBlackColor">#111318</Color>
            <SolidColorBrush x:Key="InkBlack" Color="#111318" />
            <Color x:Key="InkBlueColor">#1d3f9e</Color>
            <SolidColorBrush x:Key="InkBlue" Color="#1d3f9e" />
            <Color x:Key="InkRedColor">#b42318</Color>
            <SolidColorBrush x:Key="InkRed" Color="#b42318" />
            <Color x:Key="HighlightColor">#73ffd60a</Color>
            <SolidColorBrush x:Key="Highlight" Color="#73ffd60a" />
            <Color x:Key="ToastColor">#1b1e23</Color>
            <SolidColorBrush x:Key="Toast" Color="#1b1e23" />
            <Color x:Key="OnToastColor">#ffffff</Color>
            <SolidColorBrush x:Key="OnToast" Color="#ffffff" />
            <Color x:Key="OverlayColor">#7311141a</Color>
            <SolidColorBrush x:Key="Overlay" Color="#7311141a" />
            <!-- Not design-system tokens: values taken from the mockups. -->
            <SolidColorBrush x:Key="DropZoneBorder" Color="#c3b3e0" />
            <SolidColorBrush x:Key="DangerBorder" Color="#f5c2bd" />
            <SolidColorBrush x:Key="DamagedText" Color="#6a4500" />
            <SolidColorBrush x:Key="ChoiceSelected" Color="#efe7fb" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SurfaceAppColor">#16181d</Color>
            <SolidColorBrush x:Key="SurfaceApp" Color="#16181d" />
            <Color x:Key="SurfaceColor">#1f2228</Color>
            <SolidColorBrush x:Key="Surface" Color="#1f2228" />
            <Color x:Key="SurfaceSubtleColor">#26292f</Color>
            <SolidColorBrush x:Key="SurfaceSubtle" Color="#26292f" />
            <Color x:Key="SurfaceSunkenColor">#2a2d34</Color>
            <SolidColorBrush x:Key="SurfaceSunken" Color="#2a2d34" />
            <Color x:Key="CanvasColor">#1b1d22</Color>
            <SolidColorBrush x:Key="Canvas" Color="#1b1d22" />
            <Color x:Key="PageColor">#fdfcf8</Color>
            <SolidColorBrush x:Key="Page" Color="#fdfcf8" />
            <Color x:Key="BorderSubtleColor">#2e323a</Color>
            <SolidColorBrush x:Key="BorderSubtle" Color="#2e323a" />
            <Color x:Key="BorderControlColor">#7c828c</Color>
            <SolidColorBrush x:Key="BorderControl" Color="#7c828c" />
            <Color x:Key="BorderControlOnSunkenColor">#7c828c</Color>
            <SolidColorBrush x:Key="BorderControlOnSunken" Color="#7c828c" />
            <Color x:Key="TextColor">#e6e8eb</Color>
            <SolidColorBrush x:Key="Text" Color="#e6e8eb" />
            <Color x:Key="TextMutedColor">#b5b9c0</Color>
            <SolidColorBrush x:Key="TextMuted" Color="#b5b9c0" />
            <Color x:Key="TextDisabledColor">#8b9099</Color>
            <SolidColorBrush x:Key="TextDisabled" Color="#8b9099" />
            <Color x:Key="AccentColor">#c4aef4</Color>
            <SolidColorBrush x:Key="Accent" Color="#c4aef4" />
            <Color x:Key="AccentStrongColor">#d6c7fb</Color>
            <SolidColorBrush x:Key="AccentStrong" Color="#d6c7fb" />
            <Color x:Key="AccentTintColor">#32264d</Color>
            <SolidColorBrush x:Key="AccentTint" Color="#32264d" />
            <!-- A light fill with a dark label (7.7:1); its edge is 6:1 or more on every dark surface. -->
            <Color x:Key="PrimaryColor">#b79df2</Color>
            <SolidColorBrush x:Key="Primary" Color="#b79df2" />
            <Color x:Key="OnPrimaryColor">#16181d</Color>
            <SolidColorBrush x:Key="OnPrimary" Color="#16181d" />
            <!-- Lighter under the pointer (label 11:1). -->
            <SolidColorBrush x:Key="PrimaryHover" Color="#d6c7fb" />
            <SolidColorBrush x:Key="PrimaryHoverBorder" Color="#d6c7fb" />
            <Color x:Key="FocusRingColor">#d6c7fb</Color>
            <SolidColorBrush x:Key="FocusRing" Color="#d6c7fb" />
            <!-- Pages stay light in dark mode, where #d6c7fb would be 1.5:1, so the ring on them keeps the light theme's. -->
            <SolidColorBrush x:Key="FocusRingOnPage" Color="#4a2a7a" />
            <SolidColorBrush x:Key="TextSelection" Color="#4a3780" />
            <Color x:Key="SelectionOnPageColor">#6334b4</Color>
            <SolidColorBrush x:Key="SelectionOnPage" Color="#6334b4" />
            <SolidColorBrush x:Key="Guide" Color="#fca65f" />
            <SolidColorBrush x:Key="GuideTint" Color="#43261a" />
            <SolidColorBrush x:Key="GuideStrong" Color="#fdba74" />
            <!-- Pages stay white in dark mode, so the outline on them keeps the light theme's orange. -->
            <Color x:Key="GuideOnPageColor">#9f350a</Color>
            <Color x:Key="WarningColor">#f0ab6d</Color>
            <SolidColorBrush x:Key="Warning" Color="#f0ab6d" />
            <Color x:Key="WarningTintColor">#3a2a1a</Color>
            <SolidColorBrush x:Key="WarningTint" Color="#3a2a1a" />
            <Color x:Key="WarningBorderColor">#6b4a2a</Color>
            <SolidColorBrush x:Key="WarningBorder" Color="#6b4a2a" />
            <Color x:Key="DangerColor">#ffa097</Color>
            <SolidColorBrush x:Key="Danger" Color="#ffa097" />
            <!-- As with Primary: a light fill with a dark label (7.8:1), its edge 6:1 or more on every dark surface. -->
            <Color x:Key="DangerFillColor">#ff8a80</Color>
            <SolidColorBrush x:Key="DangerFill" Color="#ff8a80" />
            <!-- Lighter under the pointer (label 10:1). -->
            <SolidColorBrush x:Key="DangerFillHover" Color="#ffb3ab" />
            <SolidColorBrush x:Key="DangerFillHoverBorder" Color="#ffb3ab" />
            <Color x:Key="DangerTintColor">#3a1d1b</Color>
            <SolidColorBrush x:Key="DangerTint" Color="#3a1d1b" />
            <Color x:Key="SuccessColor">#7fd19b</Color>
            <SolidColorBrush x:Key="Success" Color="#7fd19b" />
            <Color x:Key="SuccessTintColor">#1a3324</Color>
            <SolidColorBrush x:Key="SuccessTint" Color="#1a3324" />
            <Color x:Key="UnsavedColor">#f0a868</Color>
            <SolidColorBrush x:Key="Unsaved" Color="#f0a868" />
            <Color x:Key="InfoTintColor">#2a2340</Color>
            <SolidColorBrush x:Key="InfoTint" Color="#2a2340" />
            <Color x:Key="InkBlackColor">#111318</Color>
            <SolidColorBrush x:Key="InkBlack" Color="#111318" />
            <Color x:Key="InkBlueColor">#1d3f9e</Color>
            <SolidColorBrush x:Key="InkBlue" Color="#1d3f9e" />
            <Color x:Key="InkRedColor">#b42318</Color>
            <SolidColorBrush x:Key="InkRed" Color="#b42318" />
            <Color x:Key="HighlightColor">#73ffd60a</Color>
            <SolidColorBrush x:Key="Highlight" Color="#73ffd60a" />
            <Color x:Key="ToastColor">#e6e8eb</Color>
            <SolidColorBrush x:Key="Toast" Color="#e6e8eb" />
            <Color x:Key="OnToastColor">#1b1e23</Color>
            <SolidColorBrush x:Key="OnToast" Color="#1b1e23" />
            <Color x:Key="OverlayColor">#99000000</Color>
            <SolidColorBrush x:Key="Overlay" Color="#99000000" />
            <SolidColorBrush x:Key="DropZoneBorder" Color="#5e4b86" />
            <SolidColorBrush x:Key="DangerBorder" Color="#6b2c27" />
            <SolidColorBrush x:Key="DamagedText" Color="#f0ab6d" />
            <SolidColorBrush x:Key="ChoiceSelected" Color="#32264d" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="TitleStripHeight">40</x:Double>
    <x:Double x:Key="ContextBarHeight">52</x:Double>
    <x:Double x:Key="StatusBarHeight">40</x:Double>
    <x:Double x:Key="PagesPanelWidth">196</x:Double>
    <!-- Page thumbnails in the pages panel; resized with the panel (EditorView.SetPagesPanelWidth). -->
    <x:Double x:Key="PagesThumbWidth">116</x:Double>
    <x:Double x:Key="PagesThumbHeight">150</x:Double>
    <x:Double x:Key="ControlHeight">36</x:Double>
    <x:Double x:Key="ControlHeightLarge">40</x:Double>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">10</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">14</CornerRadius>
    <BoxShadows x:Key="ShadowPopover">0 16 40 0 #2e000000</BoxShadows>
    <BoxShadows x:Key="ShadowDialog">0 24 64 0 #47000000</BoxShadows>
</ResourceDictionary>
