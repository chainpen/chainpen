<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Fillsign.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fillsign.App.ViewModels"
             xmlns:c="using:Fillsign.App.Controls"
             x:Class="Fillsign.App.Views.StartView"
             x:DataType="vm:StartViewModel">
    <!-- 🎨 2 / 9: the start screen. -->
    <DockPanel Background="{DynamicResource SurfaceApp}">
        <Border x:Name="TitleStrip" DockPanel.Dock="Top" Height="{StaticResource TitleStripHeight}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1" Padding="12,0">
            <Panel>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Fillsign" />
                <Button HorizontalAlignment="Right" Classes="tool" Click="OnSettings" ToolTip.Tip="{x:Static l:Strings.Start_Settings}" AutomationProperties.Name="{x:Static l:Strings.Start_Settings}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:StrokeIcon Data="{StaticResource IconSettings}" />
                        <TextBlock Text="{x:Static l:Strings.Start_Settings}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Panel>
        </Border>

        <!-- FS-902: a crash report is waiting; the person reviews it in a GitHub issue before anything is sent. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasCrashReport}" Background="{DynamicResource InfoTint}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="24,12"
                AutomationProperties.LiveSetting="Polite">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="primary" MinHeight="36" Content="{x:Static l:Strings.Start_ReviewAndSend}" Click="OnSendCrashReport"
                            ToolTip.Tip="{x:Static l:Strings.Start_OpensAGitHubIssueWithThe}" />
                    <Button MinHeight="36" Content="{x:Static l:Strings.Common_Delete}" Click="OnDeleteCrashReports" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run FontWeight="SemiBold" Text="{x:Static l:Strings.Start_FillsignHitAProblemLastTime}" />
                    <Run Text="{x:Static l:Strings.Start_AReportOfWhatWentWrong}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- FS-902: asked once, from the second start; off until the person says yes (FS-016). -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding AsksAboutCrashReports}" Background="{DynamicResource InfoTint}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="primary" MinHeight="36" Content="{x:Static l:Strings.Start_YesKeepReports}" Click="OnCrashReportsYes" />
                    <Button MinHeight="36" Content="{x:Static l:Strings.Start_NoThanks}" Click="OnCrashReportsNo" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run FontWeight="SemiBold" Text="{x:Static l:Strings.Start_HelpFixProblems}" />
                    <Run Text="{x:Static l:Strings.Start_IfSomethingGoesWrongFillsignCan}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- After an unexpected shutdown (FR-8.12): recover, or put it off to Recent. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasRecovery}" Background="{DynamicResource WarningTint}"
                BorderBrush="{DynamicResource WarningBorder}" BorderThickness="0,0,0,1" Padding="24,12"
                AutomationProperties.LiveSetting="Assertive">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="primary" MinHeight="36" Content="{x:Static l:Strings.Start_RecoverChanges}" Click="OnRecover" />
                    <Button MinHeight="36" Content="{x:Static l:Strings.Start_NotNow}" Click="OnNotNow" ToolTip.Tip="{x:Static l:Strings.Start_YouCanRecoverItFromRecent}" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                    <c:StrokeIcon Data="{StaticResource IconClock}" Foreground="{DynamicResource Warning}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="{Binding RecoveryTitle}" />
                        <Run Text="{Binding RecoveryText}" />
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

    <ScrollViewer>
        <StackPanel MaxWidth="880" Margin="24,48,24,40" Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Classes="heading-page" Text="{x:Static l:Strings.Start_FillInAndSignADocument}" />
                <TextBlock Classes="muted" FontSize="16" TextWrapping="Wrap"
                           Text="{x:Static l:Strings.Start_OpenAPDFOrAPhoto}" />
            </StackPanel>

            <!-- D6: what went wrong with the last open. -->
            <Border IsVisible="{Binding HasProblem}" Background="{DynamicResource DangerTint}"
                    BorderBrush="{DynamicResource DangerBorder}" BorderThickness="4,1,1,1"
                    CornerRadius="12" Padding="20,18" AutomationProperties.LiveSetting="Assertive">
                <Grid ColumnDefinitions="24,*" ColumnSpacing="14">
                    <c:StrokeIcon Data="{StaticResource IconFileX}" Size="24" Foreground="{DynamicResource Danger}" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Problem.Title, FallbackValue=''}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding Problem.Message, FallbackValue=''}" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <Button Classes="primary" Content="{x:Static l:Strings.Start_ChooseAnotherFile}" Click="OnOpen" />
                            <Button Content="{x:Static l:Strings.Common_Dismiss}" Click="OnDismissProblem" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Drop zone. Dropping anywhere on the window works too. -->
            <Grid>
                <Rectangle Stroke="{DynamicResource DropZoneBorder}" StrokeThickness="2" StrokeDashArray="3,2"
                           RadiusX="14" RadiusY="14" Fill="{DynamicResource Surface}" />
                <WrapPanel Margin="32,36" ItemSpacing="24" LineSpacing="16" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="14" Background="{DynamicResource AccentTint}">
                        <c:StrokeIcon Data="{StaticResource IconFileUpload}" Size="32" Foreground="{DynamicResource Accent}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Width="420" Spacing="4">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{x:Static l:Strings.Start_DropFilesHereToOpenThem}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding DropHint}" />
                    </StackPanel>
                    <Button Classes="primary" VerticalAlignment="Center" Click="OnOpen" IsEnabled="{Binding !IsOpening}"
                            ToolTip.Tip="{c:Keys {x:Static l:Strings.Start_OpenAPDFOrImageMod}}">
                        <StackPanel Classes="content">
                            <c:StrokeIcon Data="{StaticResource IconFolder}" />
                            <TextBlock Text="{x:Static l:Strings.Start_Open}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <!-- Recent (FR-1.7): newest first, with what can be recovered. -->
            <Border IsVisible="{Binding HasRecent}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                <StackPanel>
                    <DockPanel Margin="16,10,8,10">
                        <Button DockPanel.Dock="Right" Classes="link" Content="{x:Static l:Strings.Start_ClearList}" Click="OnClearRecent" />
                        <TextBlock x:Name="RecentHeading" Classes="heading-section" FontSize="15" VerticalAlignment="Center" Text="{x:Static l:Strings.Start_Recent}" />
                    </DockPanel>
                    <Grid Classes="recentHeader" ColumnDefinitions="*,140">
                        <TextBlock Text="{x:Static l:Strings.Start_Name}" />
                        <TextBlock Grid.Column="1" Text="{x:Static l:Strings.Start_LastOpened}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Recent}" AutomationProperties.LabeledBy="{Binding #RecentHeading}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentItemViewModel">
                                <Button Classes="recentRow" Click="OnOpenRecent" AutomationProperties.Name="{Binding AccessibleName}">
                                    <Grid ColumnDefinitions="*,140">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border Width="32" Height="40" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource BorderControl}"
                                                    Background="{DynamicResource Page}" />
                                            <StackPanel VerticalAlignment="Center" MaxWidth="560">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="muted" FontSize="12" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                                                <!-- Only when there's something to say: a column of dashes was noise (UX review 9). -->
                                                <TextBlock FontSize="12" Margin="0,2,0,0" IsVisible="{Binding HasStatus}"
                                                           Classes.warning="{Binding IsWarning}" Classes="status" Text="{Binding Status}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{Binding LastOpened}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- First launch: how it works, and a practice form (FR-1.8). -->
            <StackPanel IsVisible="{Binding IsFirstLaunch}" Spacing="10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" MinHeight="36" FontSize="13" Click="OnPracticeForm"
                            Content="{x:Static l:Strings.Start_TryItWithAPracticeForm}"
                            ToolTip.Tip="{x:Static l:Strings.Start_OpensAPracticeFormWithA}" />
                    <TextBlock Classes="heading-section" VerticalAlignment="Center" Text="{x:Static l:Strings.Start_HowItWorks}" />
                </DockPanel>
                <UniformGrid Columns="3" ColumnSpacing="12">
                    <Border Padding="16" CornerRadius="12" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource Surface}">
                        <StackPanel Spacing="6">
                            <Border Classes="badge"><TextBlock Text="1" /></Border>
                            <TextBlock FontWeight="SemiBold" Text="{x:Static l:Strings.Start_OpenYourForm}" />
                            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="{x:Static l:Strings.Start_APDFOrAPhotoOr}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="16" CornerRadius="12" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource Surface}">
                        <StackPanel Spacing="6">
                            <Border Classes="badge"><TextBlock Text="2" /></Border>
                            <TextBlock FontWeight="SemiBold" Text="{x:Static l:Strings.Start_TickTypeAndSign}" />
                            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="{x:Static l:Strings.Start_ChooseAToolThenClickWhere}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="16" CornerRadius="12" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSubtle}" Background="{DynamicResource Surface}">
                        <StackPanel Spacing="6">
                            <Border Classes="badge"><TextBlock Text="3" /></Border>
                            <TextBlock FontWeight="SemiBold" Text="{x:Static l:Strings.Common_ExportAFinalCopy}" />
                            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="{x:Static l:Strings.Start_AFileThatLooksTheSame}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="{x:Static l:Strings.Start_DocumentsYouOpenWillBeListed}" />
            </StackPanel>

            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                       Text="{x:Static l:Strings.Start_NothingLeavesThisComputerFillsignDoesnt}" />
            <!-- The licence in a sentence (FS-027): free for personal use, and for everyone during the beta. -->
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{x:Static l:Strings.Start_FreeForPersonalUseAndFree}" />
        </StackPanel>
    </ScrollViewer>
    </DockPanel>

    <UserControl.Styles>
        <Style Selector="Grid.recentHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Grid.recentHeader > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Margin" Value="16,8" />
        </Style>
        <Style Selector="Button.recentRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.status.warning">
            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
    </UserControl.Styles>
</UserControl>
