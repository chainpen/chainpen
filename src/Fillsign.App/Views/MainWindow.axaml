<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fillsign.App.ViewModels"
        x:Class="Fillsign.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://Fillsign.App/Assets/Icon/fillsign-256.png"
        Width="1280" Height="860" MinWidth="1024" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">
    <Panel>
        <ContentControl x:Name="Host" />
        <!-- Windows and Linux show the menus at the left of the strip with the document's name, not in a row of their
             own (FS-700); on macOS they're in the system menu bar. -->
        <NativeMenuBar x:Name="MenuBar" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,0,0,0"
                       Height="{StaticResource TitleStripHeight}" />

        <!-- Modal dialogs over a dimmed window. -->
        <Border x:Name="DialogLayer" IsVisible="False" Background="{DynamicResource Overlay}" KeyboardNavigation.TabNavigation="Cycle">
            <ContentControl x:Name="DialogHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0" />
        </Border>
    </Panel>
</Window>
