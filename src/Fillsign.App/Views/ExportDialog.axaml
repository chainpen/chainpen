<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Fillsign.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Fillsign.App.Controls"
             x:Class="Fillsign.App.Views.ExportDialog"
             Width="640">
    <!-- 🎨 6 / S5: the file to send, kept apart from the working copy. -->
    <Border Classes="dialog">
        <!-- FS-709: on a short window the middle scrolls; the title and buttons stay put (S5). -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Classes="icon" BorderThickness="0" Background="Transparent" Click="OnCancel"
                        AutomationProperties.Name="{x:Static l:Strings.Common_Close}">
                    <c:StrokeIcon Data="{StaticResource IconCross}" Foreground="{DynamicResource TextMuted}" />
                </Button>
                <TextBlock Classes="heading-dialog" FontSize="20" VerticalAlignment="Center" Text="{x:Static l:Strings.Common_ExportFinalCopy}" />
            </DockPanel>

            <Border DockPanel.Dock="Bottom" Margin="0,22,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
                        <Button Content="{x:Static l:Strings.Export_KeepEditing}" Click="OnCancel" />
                        <Button x:Name="ExportButton" Classes="primary" Content="{x:Static l:Strings.Common_ExportFinalCopy}" Click="OnExport" />
                    </StackPanel>
                    <TextBlock x:Name="SizeText" Classes="muted" FontSize="13" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="Body" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="-4,0">
                <StackPanel Margin="4,4">
                    <TextBlock x:Name="Lede" Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{x:Static l:Strings.Export_MakesACopyToSendIt}" />

                    <!-- Possible gaps (FS-609, FR-8.3): hints, never a verdict. -->
                    <Border x:Name="GapsSection" Margin="0,18,0,0" IsVisible="False" CornerRadius="12" ClipToBounds="True"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderControl}">
                        <StackPanel>
                            <!-- Its own rounded top corners (the card's 12 less its 1 border): children are clipped to a
                                 rectangle, so a square background would paint over the card's rounded border. -->
                            <Border Background="{DynamicResource SurfaceSubtle}" CornerRadius="11,11,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="GapsHeading" Margin="14,12,14,0" FontSize="14" FontWeight="SemiBold" Text="{x:Static l:Strings.Export_PossibleGaps}" />
                                    <TextBlock x:Name="GapsNote" Classes="muted" Margin="14,0,14,12" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="GapRows" />
                        </StackPanel>
                    </Border>

                    <!-- FS-950: a filled form can be locked so whoever receives it can't change the answers. -->
                    <CheckBox x:Name="LockFields" Margin="0,18,0,0" IsChecked="True" IsVisible="False">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Static l:Strings.Export_LockTheFormsFields}" />
                            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" MaxWidth="540"
                                       Text="{x:Static l:Strings.Export_YourAnswersShowAsFilledIn}" />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock x:Name="NameLabel" Margin="0,20,0,6" FontWeight="SemiBold" Text="{x:Static l:Strings.Export_FileName}" />
                    <TextBox x:Name="FileName" FontSize="14" AutomationProperties.LabeledBy="{Binding #NameLabel}" KeyDown="OnNameKeyDown" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Classes="small" Content="{x:Static l:Strings.Export_ChangeFolder}" Click="OnChangeFolder" />
                        <TextBlock x:Name="SavesTo" Classes="muted" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel x:Name="ReplaceNote" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" IsVisible="False">
                        <c:StrokeIcon Data="{StaticResource IconWarning}" Size="16" Foreground="{DynamicResource Warning}" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" MaxWidth="540"
                                   Text="{x:Static l:Strings.Export_AFileWithThisNameIs}" />
                    </StackPanel>
                    <StackPanel x:Name="NameProblem" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" IsVisible="False"
                                AutomationProperties.LiveSetting="Assertive">
                        <c:StrokeIcon Data="{StaticResource IconWarningCircle}" Size="16" Foreground="{DynamicResource Danger}" />
                        <TextBlock x:Name="NameProblemText" FontSize="13" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" MaxWidth="540"
                                   Text="{x:Static l:Strings.Export_TypeANameForTheFinal}" />
                    </StackPanel>


                    <CheckBox x:Name="AlsoSave" Margin="0,16,0,0" IsChecked="True">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Static l:Strings.Export_AlsoSaveTheWorkingCopy}" />
                            <TextBlock x:Name="AlsoSaveDetail" Classes="muted" FontSize="13" TextWrapping="Wrap" MaxWidth="540" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
