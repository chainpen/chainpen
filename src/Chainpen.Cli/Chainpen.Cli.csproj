  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chainpen.Pdf\Chainpen.Pdf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Chainpen.Cli.Tests" />
  </ItemGroup>
</Project>
