<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Colour tokens copied from the Fillsign design system (tokens.json): one Color and one brush per token, named
        in PascalCase (surface-subtle → SurfaceSubtle). Keep in step with the design system. The page and the
        document inks are the same in both themes, because the document is never themed.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SurfaceAppColor">#f4f5f7</Color>
            <SolidColorBrush x:Key="SurfaceApp" Color="#f4f5f7" />
            <Color x:Key="SurfaceColor">#ffffff</Color>
            <SolidColorBrush x:Key="Surface" Color="#ffffff" />
            <Color x:Key="SurfaceSubtleColor">#fbfbfc</Color>
            <SolidColorBrush x:Key="SurfaceSubtle" Color="#fbfbfc" />
            <Color x:Key="SurfaceSunkenColor">#eef0f3</Color>
            <SolidColorBrush x:Key="SurfaceSunken" Color="#eef0f3" />
            <Color x:Key="CanvasColor">#e9ebef</Color>
            <SolidColorBrush x:Key="Canvas" Color="#e9ebef" />
            <Color x:Key="PageColor">#fdfcf8</Color>
            <SolidColorBrush x:Key="Page" Color="#fdfcf8" />
            <Color x:Key="BorderSubtleColor">#e3e5e9</Color>
            <SolidColorBrush x:Key="BorderSubtle" Color="#e3e5e9" />
            <Color x:Key="BorderControlColor">#868c96</Color>
            <SolidColorBrush x:Key="BorderControl" Color="#868c96" />
            <Color x:Key="BorderControlOnSunkenColor">#7d838d</Color>
            <SolidColorBrush x:Key="BorderControlOnSunken" Color="#7d838d" />
            <Color x:Key="TextColor">#1b1e23</Color>
            <SolidColorBrush x:Key="Text" Color="#1b1e23" />
            <Color x:Key="TextMutedColor">#4a505a</Color>
            <SolidColorBrush x:Key="TextMuted" Color="#4a505a" />
            <Color x:Key="TextDisabledColor">#5c626c</Color>
            <SolidColorBrush x:Key="TextDisabled" Color="#5c626c" />
            <Color x:Key="AccentColor">#1f4fc4</Color>
            <SolidColorBrush x:Key="Accent" Color="#1f4fc4" />
            <Color x:Key="AccentStrongColor">#173c96</Color>
            <SolidColorBrush x:Key="AccentStrong" Color="#173c96" />
            <Color x:Key="AccentTintColor">#e8eefc</Color>
            <SolidColorBrush x:Key="AccentTint" Color="#e8eefc" />
            <Color x:Key="PrimaryColor">#1f4fc4</Color>
            <SolidColorBrush x:Key="Primary" Color="#1f4fc4" />
            <Color x:Key="OnPrimaryColor">#ffffff</Color>
            <SolidColorBrush x:Key="OnPrimary" Color="#ffffff" />
            <Color x:Key="FocusRingColor">#173c96</Color>
            <SolidColorBrush x:Key="FocusRing" Color="#173c96" />
            <Color x:Key="SelectionOnPageColor">#1f4fc4</Color>
            <SolidColorBrush x:Key="SelectionOnPage" Color="#1f4fc4" />
            <Color x:Key="WarningColor">#92400e</Color>
            <SolidColorBrush x:Key="Warning" Color="#92400e" />
            <Color x:Key="WarningTintColor">#fff7ed</Color>
            <SolidColorBrush x:Key="WarningTint" Color="#fff7ed" />
            <Color x:Key="WarningBorderColor">#f3d3b0</Color>
            <SolidColorBrush x:Key="WarningBorder" Color="#f3d3b0" />
            <Color x:Key="DangerColor">#b42318</Color>
            <SolidColorBrush x:Key="Danger" Color="#b42318" />
            <Color x:Key="DangerFillColor">#b42318</Color>
            <SolidColorBrush x:Key="DangerFill" Color="#b42318" />
            <Color x:Key="DangerTintColor">#fdecea</Color>
            <SolidColorBrush x:Key="DangerTint" Color="#fdecea" />
            <Color x:Key="SuccessColor">#1d6b3a</Color>
            <SolidColorBrush x:Key="Success" Color="#1d6b3a" />
            <Color x:Key="SuccessTintColor">#ecf7ef</Color>
            <SolidColorBrush x:Key="SuccessTint" Color="#ecf7ef" />
            <Color x:Key="UnsavedColor">#c2410c</Color>
            <SolidColorBrush x:Key="Unsaved" Color="#c2410c" />
            <Color x:Key="InfoTintColor">#eef4ff</Color>
            <SolidColorBrush x:Key="InfoTint" Color="#eef4ff" />
            <Color x:Key="InkBlackColor">#111318</Color>
            <SolidColorBrush x:Key="InkBlack" Color="#111318" />
            <Color x:Key="InkBlueColor">#1d3f9e</Color>
            <SolidColorBrush x:Key="InkBlue" Color="#1d3f9e" />
            <Color x:Key="InkRedColor">#b42318</Color>
            <SolidColorBrush x:Key="InkRed" Color="#b42318" />
            <SolidColorBrush x:Key="InkGreen" Color="#1a6b3a" />
            <SolidColorBrush x:Key="InkPurple" Color="#5b2a86" />
            <Color x:Key="HighlightColor">#73ffd60a</Color>
            <SolidColorBrush x:Key="Highlight" Color="#73ffd60a" />
            <Color x:Key="ToastColor">#1b1e23</Color>
            <SolidColorBrush x:Key="Toast" Color="#1b1e23" />
            <Color x:Key="OnToastColor">#ffffff</Color>
            <SolidColorBrush x:Key="OnToast" Color="#ffffff" />
            <Color x:Key="OverlayColor">#7311141a</Color>
            <SolidColorBrush x:Key="Overlay" Color="#7311141a" />
            <!-- Not design-system tokens: values taken from the mockups. -->
            <SolidColorBrush x:Key="DropZoneBorder" Color="#b7c3dc" />
            <SolidColorBrush x:Key="DangerBorder" Color="#f5c2bd" />
            <SolidColorBrush x:Key="DamagedText" Color="#8a5a00" />
            <SolidColorBrush x:Key="ChoiceSelected" Color="#f3f6fd" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SurfaceAppColor">#16181d</Color>
            <SolidColorBrush x:Key="SurfaceApp" Color="#16181d" />
            <Color x:Key="SurfaceColor">#1f2228</Color>
            <SolidColorBrush x:Key="Surface" Color="#1f2228" />
            <Color x:Key="SurfaceSubtleColor">#26292f</Color>
            <SolidColorBrush x:Key="SurfaceSubtle" Color="#26292f" />
            <Color x:Key="SurfaceSunkenColor">#2a2d34</Color>
            <SolidColorBrush x:Key="SurfaceSunken" Color="#2a2d34" />
            <Color x:Key="CanvasColor">#1b1d22</Color>
            <SolidColorBrush x:Key="Canvas" Color="#1b1d22" />
            <Color x:Key="PageColor">#fdfcf8</Color>
            <SolidColorBrush x:Key="Page" Color="#fdfcf8" />
            <Color x:Key="BorderSubtleColor">#2e323a</Color>
            <SolidColorBrush x:Key="BorderSubtle" Color="#2e323a" />
            <Color x:Key="BorderControlColor">#7c828c</Color>
            <SolidColorBrush x:Key="BorderControl" Color="#7c828c" />
            <Color x:Key="BorderControlOnSunkenColor">#7c828c</Color>
            <SolidColorBrush x:Key="BorderControlOnSunken" Color="#7c828c" />
            <Color x:Key="TextColor">#e6e8eb</Color>
            <SolidColorBrush x:Key="Text" Color="#e6e8eb" />
            <Color x:Key="TextMutedColor">#a9aeb6</Color>
            <SolidColorBrush x:Key="TextMuted" Color="#a9aeb6" />
            <Color x:Key="TextDisabledColor">#8b9099</Color>
            <SolidColorBrush x:Key="TextDisabled" Color="#8b9099" />
            <Color x:Key="AccentColor">#7aa2ff</Color>
            <SolidColorBrush x:Key="Accent" Color="#7aa2ff" />
            <Color x:Key="AccentStrongColor">#a9c1ff</Color>
            <SolidColorBrush x:Key="AccentStrong" Color="#a9c1ff" />
            <Color x:Key="AccentTintColor">#24304d</Color>
            <SolidColorBrush x:Key="AccentTint" Color="#24304d" />
            <Color x:Key="PrimaryColor">#2f5fe0</Color>
            <SolidColorBrush x:Key="Primary" Color="#2f5fe0" />
            <Color x:Key="OnPrimaryColor">#ffffff</Color>
            <SolidColorBrush x:Key="OnPrimary" Color="#ffffff" />
            <Color x:Key="FocusRingColor">#a9c1ff</Color>
            <SolidColorBrush x:Key="FocusRing" Color="#a9c1ff" />
            <Color x:Key="SelectionOnPageColor">#1f4fc4</Color>
            <SolidColorBrush x:Key="SelectionOnPage" Color="#1f4fc4" />
            <Color x:Key="WarningColor">#f0a868</Color>
            <SolidColorBrush x:Key="Warning" Color="#f0a868" />
            <Color x:Key="WarningTintColor">#3a2a1a</Color>
            <SolidColorBrush x:Key="WarningTint" Color="#3a2a1a" />
            <Color x:Key="WarningBorderColor">#6b4a2a</Color>
            <SolidColorBrush x:Key="WarningBorder" Color="#6b4a2a" />
            <Color x:Key="DangerColor">#ff8a80</Color>
            <SolidColorBrush x:Key="Danger" Color="#ff8a80" />
            <Color x:Key="DangerFillColor">#c4372b</Color>
            <SolidColorBrush x:Key="DangerFill" Color="#c4372b" />
            <Color x:Key="DangerTintColor">#3a1d1b</Color>
            <SolidColorBrush x:Key="DangerTint" Color="#3a1d1b" />
            <Color x:Key="SuccessColor">#7fd19b</Color>
            <SolidColorBrush x:Key="Success" Color="#7fd19b" />
            <Color x:Key="SuccessTintColor">#1a3324</Color>
            <SolidColorBrush x:Key="SuccessTint" Color="#1a3324" />
            <Color x:Key="UnsavedColor">#f0a868</Color>
            <SolidColorBrush x:Key="Unsaved" Color="#f0a868" />
            <Color x:Key="InfoTintColor">#1e2a42</Color>
            <SolidColorBrush x:Key="InfoTint" Color="#1e2a42" />
            <Color x:Key="InkBlackColor">#111318</Color>
            <SolidColorBrush x:Key="InkBlack" Color="#111318" />
            <Color x:Key="InkBlueColor">#1d3f9e</Color>
            <SolidColorBrush x:Key="InkBlue" Color="#1d3f9e" />
            <Color x:Key="InkRedColor">#b42318</Color>
            <SolidColorBrush x:Key="InkRed" Color="#b42318" />
            <SolidColorBrush x:Key="InkGreen" Color="#1a6b3a" />
            <SolidColorBrush x:Key="InkPurple" Color="#5b2a86" />
            <Color x:Key="HighlightColor">#73ffd60a</Color>
            <SolidColorBrush x:Key="Highlight" Color="#73ffd60a" />
            <Color x:Key="ToastColor">#e6e8eb</Color>
            <SolidColorBrush x:Key="Toast" Color="#e6e8eb" />
            <Color x:Key="OnToastColor">#1b1e23</Color>
            <SolidColorBrush x:Key="OnToast" Color="#1b1e23" />
            <Color x:Key="OverlayColor">#99000000</Color>
            <SolidColorBrush x:Key="Overlay" Color="#99000000" />
            <SolidColorBrush x:Key="DropZoneBorder" Color="#4a5878" />
            <SolidColorBrush x:Key="DangerBorder" Color="#6b2c27" />
            <SolidColorBrush x:Key="DamagedText" Color="#f0a868" />
            <SolidColorBrush x:Key="ChoiceSelected" Color="#24304d" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="TitleStripHeight">40</x:Double>
    <x:Double x:Key="ContextBarHeight">52</x:Double>
    <x:Double x:Key="StatusBarHeight">40</x:Double>
    <x:Double x:Key="PagesPanelWidth">196</x:Double>
    <x:Double x:Key="ControlHeight">36</x:Double>
    <x:Double x:Key="ControlHeightLarge">40</x:Double>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">10</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">14</CornerRadius>
    <BoxShadows x:Key="ShadowPopover">0 16 40 0 #2e000000</BoxShadows>
    <BoxShadows x:Key="ShadowDialog">0 24 64 0 #47000000</BoxShadows>
</ResourceDictionary>
