<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Chainpen.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chainpen.App.Views.ShortcutsPanel"
             Width="440">
    <!-- E8: every shortcut, with the system's own command key (FR-7.13). -->
    <StackPanel x:Name="Rows" Spacing="2">
        <TextBlock x:Name="Title" Classes="heading-section" Text="{x:Static l:Strings.Common_KeyboardShortcuts}" Margin="0,0,0,4" />
    </StackPanel>
    <UserControl.Styles>
        <Style Selector="TextBlock.group">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </UserControl.Styles>
</UserControl>
