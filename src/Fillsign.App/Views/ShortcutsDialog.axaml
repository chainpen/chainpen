<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Fillsign.App.Views"
             x:Class="Fillsign.App.Views.ShortcutsDialog">
    <!-- Help → Keyboard shortcuts: the toolbar popover's list as a dialog. -->
    <Border Classes="dialog">
        <StackPanel>
            <v:ShortcutsPanel />
            <TextBlock x:Name="PlatformNote" Classes="muted" FontSize="12" Margin="0,12,0,0" />
            <Button x:Name="CloseButton" Classes="primary" HorizontalAlignment="Right" Margin="0,16,0,0" Content="Close" Click="OnClose" />
        </StackPanel>
    </Border>
</UserControl>
