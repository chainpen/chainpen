<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Control looks from the design system's Button, ToolButton and FocusAndSelection components. -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource SurfaceApp}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Focus: a 2px focus-ring with a 2px gap, on every focusable control. It sits outside the control, so it isn't
         clipped: the control itself, a list or a scroll area around it would cut part or all of it away. -->
    <Style Selector=":is(Control)">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{DynamicResource FocusRing}" BorderThickness="2" CornerRadius="10" Margin="-4"
                        AdornerLayer.IsClipEnabled="False" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.heading-page">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>
    <Style Selector="TextBlock.heading-dialog">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.heading-section">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Standard button: 40 tall, control border, surface fill. -->
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightLarge}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
    </Style>

    <!-- Primary: the one main button on a screen. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    </Style>

    <!-- Borderless text button in the accent colour ("Clear list", "Show"). -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentTint}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentStrong}" />
    </Style>

    <!-- Toolbar button: 36 tall, no border until hovered or on. -->
    <Style Selector="Button.tool, ToggleButton.tool">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <!-- Disabled buttons fade rather than turning grey (Redo with nothing to redo). -->
    <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Button.tool:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.icon, ToggleButton.icon">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource ControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.small">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.small.icon">
        <Setter Property="Width" Value="32" />
    </Style>

    <!-- A button's icon follows its text colour. -->
    <Style Selector="Button StackPanel.content">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>


    <!-- A tool that's on (E1): accent tint, border and text. -->
    <Style Selector="Button.tool.on /template/ ContentPresenter#PART_ContentPresenter, Button.tool.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- The button the practice guide (or the nudge) wants next: a pale orange fill with an orange border and text,
         apart from the violet of a tool that's on, and the same on every button (Export too). The view also points an
         arrow at it. -->
    <Style Selector="Button.guided /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GuideTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Guide}" />
        <Setter Property="Foreground" Value="{DynamicResource Guide}" />
    </Style>
    <Style Selector="Button.guided:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.guided:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GuideTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GuideStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource GuideStrong}" />
    </Style>

    <!-- Bordered action in the bar under the toolbar (Duplicate, Delete, Cancel). -->
    <Style Selector="Button.chip">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Ink colour swatches (FR-3.9): a ring shows the chosen one, plus its accessible state. -->
    <Style Selector="RadioButton.swatch">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Ellipse Name="Ring" Width="32" Height="32" Stroke="{DynamicResource BorderControl}" StrokeThickness="1" />
                    <!-- A 4-point gap is a whole number of pixels at 125–200% scaling, so the colour sits centred in the ring;
                         a 3-point gap (26 inside 32) splits into half pixels and lands off-centre on Windows at 150%. -->
                    <Ellipse Margin="4" Fill="{TemplateBinding Background}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.swatch:checked /template/ Ellipse#Ring">
        <Setter Property="Stroke" Value="{DynamicResource Accent}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="RadioButton.swatch:focus-visible /template/ Ellipse#Ring">
        <Setter Property="Stroke" Value="{DynamicResource FocusRing}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <!-- Size −/+ (FR-3.9): words in the middle, the exact value in its tooltip. -->
    <Style Selector="Border.stepper">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="Border.stepper Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- A key name in a hint ("Esc"). -->
    <Style Selector="Border.kbd">
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.kbd > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- Selected text keeps the text colour on a pale highlight, as in the system's own fields; the theme's strong
         accent left dark text at about 3:1. -->
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource TextSelection}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Text}" />
    </Style>

    <!-- Text typed straight onto the page (E2): no chrome, so it sits exactly where it will be drawn. -->
    <Style Selector="TextBox.onPage">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="CaretBrush" Value="#1b1e23" />
        <Setter Property="SelectionBrush" Value="#667443c9" />
        <!-- The page is light in both themes, so selected text can't take the dark theme's pale text colour. -->
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource InkBlack}" />
    </Style>
    <Style Selector="TextBox.onPage:focus /template/ Border#PART_BorderElement, TextBox.onPage:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- FS-950: typing into one of the PDF's own fields. Opaque, so the value the page shows underneath is covered. -->
    <Style Selector="TextBox.formField">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
        <Setter Property="Background" Value="{DynamicResource Page}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBlack}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBlack}" />
    </Style>
    <Style Selector="TextBox.formField:focus /template/ Border#PART_BorderElement, TextBox.formField:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Page}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Shapes menu items (E7): icon, name and what it's for. -->
    <Style Selector="MenuItem.described">
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style Selector="Border.separator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightLarge}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Segmented switch: Signature / Initials, Edit content / Organise pages. -->
    <Style Selector="Border.segments">
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    </Style>
    <Style Selector="RadioButton.segment">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextMuted}" FontWeight="Medium" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.segment:focus-visible /template/ Border#Box">
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
    </Style>

    <!-- The red button of a destructive confirmation ("Remove signature"). -->
    <Style Selector="Button.danger-fill">
        <Setter Property="Background" Value="{DynamicResource DangerFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerFill}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    </Style>
    <Style Selector="Button.danger-fill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerFillHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerFillHoverBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    </Style>
    <!-- A dialog card over a dimmed window. -->
    <Style Selector="Border.dialog">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXLarge}" />
        <Setter Property="BoxShadow" Value="{StaticResource ShadowDialog}" />
        <Setter Property="Padding" Value="28,24" />
    </Style>

    <!-- A large radio choice with a heading and detail: Open or add (D5) and Move to (FR-6.4). -->
    <Style Selector="RadioButton.choice">
        <Setter Property="Padding" Value="12,12,16,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0">
                            <Ellipse Stroke="{DynamicResource BorderControl}" StrokeThickness="1.5" />
                            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{DynamicResource Accent}" IsVisible="False" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.choice:checked">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="11,11,15,11" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Background" Value="{DynamicResource ChoiceSelected}" />
    </Style>
    <Style Selector="RadioButton.choice:checked /template/ Ellipse#Dot">
        <Setter Property="IsVisible" Value="True" />
    </Style>

</Styles>
