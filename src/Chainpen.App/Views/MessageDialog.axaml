<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Chainpen.App.Controls"
             x:Class="Chainpen.App.Views.MessageDialog"
             Width="480">
    <!-- D6 / D9: what happened, why, and what to do. -->
    <Border Classes="dialog">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <c:StrokeIcon x:Name="Icon" Data="{StaticResource IconWarningCircle}" Size="24" Foreground="{DynamicResource Danger}" VerticalAlignment="Top" />
                <TextBlock x:Name="Heading" Classes="heading-dialog" MaxWidth="390" />
            </StackPanel>
            <StackPanel x:Name="Lines" Spacing="8" Margin="0,10,0,0" />
            <Button x:Name="OkButton" Classes="primary" HorizontalAlignment="Right" Margin="0,22,0,0" Click="OnClose" />
        </StackPanel>
    </Border>
</UserControl>
